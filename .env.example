# 이 파일을 .env 로 복사해서 값을 채우세요. (.env는 git에 올라가지 않습니다)

# 웹앱
PORT=3939
# 외부에서 접속할 수 있게 열 때는 꼭 설정하세요
ACCESS_TOKEN=
# 텔레그램 결과 메시지에 "자세히 보기" 링크를 붙일 웹앱 주소 (예: https://my-pc.tailnet.ts.net)
PUBLIC_URL=

# AI 엔진: auto(Claude 먼저, 실패하면 Codex) | claude | codex
DEFAULT_ENGINE=auto
CLAUDE_MODEL=
CODEX_MODEL=

# 텔레그램 봇: @BotFather 에서 받은 토큰
TELEGRAM_BOT_TOKEN=
# 기록을 받을 내 텔레그램 사용자 ID (여러 명이면 쉼표로 구분)
# 모르면 비워 둔 채 봇에게 아무 말이나 보내면 봇이 ID를 알려 줍니다.
TELEGRAM_ALLOWED_USERS=
